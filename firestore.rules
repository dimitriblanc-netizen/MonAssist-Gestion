rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "dimitri.blanc@dryos.fr" ||
        (request.auth.token.email is string && request.auth.token.email.matches('.*@dryos\\.fr$'))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Default catch-all: DENY ALL by default (Zero-Trust)
    match /{document=**} {
      allow read, write: if false;
    }

    // Agency Admin Workspace (dimitri.blanc@dryos.fr & DRYOS team)
    match /admin/{allDocs=**} {
      allow read, write: if isAdmin();
    }

    // Support tickets sent by landlords to DRYOS agency
    match /tickets/{ticketId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Strictly isolated landlord workspace
    // Accessible by the authenticated owner OR DRYOS agency admin for setup and assistance
    match /users/{userId} {
      allow read, write: if (isOwner(userId) || isAdmin()) && isValidId(userId);

      // Properties collection
      match /properties/{propertyId} {
        allow read, write: if (isOwner(userId) || isAdmin()) && isValidId(propertyId);
      }

      // Rents collection
      match /rents/{rentId} {
        allow read, write: if (isOwner(userId) || isAdmin()) && isValidId(rentId);
      }

      // Expenses collection
      match /expenses/{expenseId} {
        allow read, write: if (isOwner(userId) || isAdmin()) && isValidId(expenseId);
      }

      // Digital Vault & Documents collection
      match /documents/{docId} {
        allow read, write: if (isOwner(userId) || isAdmin()) && isValidId(docId);
      }

      // Any nested subcollections
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
  }
}
